# Copy to .env and use YOUR PostgreSQL service values, not MySQL values.
PGHOST=YOUR_SERVICE_HOST.aivencloud.com
PGPORT=YOUR_AIVEN_POSTGRES_PORT
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD='YOUR_PASSWORD'
PGSSLMODE=verify-full
PGSSLROOTCERT=certs/ca.pem
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
FLASK_DEBUG=0
# Set 1 only when serving the web app over HTTPS online; leave 0 on localhost HTTP.
COOKIE_SECURE=0
